<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
        <queries>
        <package android:name="com.nijatva.messages" />
        <package android:name="com.nijatva.contacts" />
        <package android:name="com.nijatva.dialer" />
        <package android:name="com.nijatva.file" />
        <package android:name="com.nijatva.gallery" />
        <package android:name="com.nijatva.camera" />
        <package android:name="com.nijatva.music.player" />
        <package android:name="in.nijatva.browser" />
        <package android:name="com.nijatva.drive" />
            <package android:name="com.nijatva.photos" />
        <package android:name="com.nijatva.photo.editor" />
        <package android:name="com.nijatva.videoplayer" />
        <package android:name="com.nijatva.mini.x" />
        <package android:name="com.nijatva.wtrlab" />
    </queries>
<application android:label="@string/app_name" android:icon="@drawable/ic_launcher" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" />

        <!-- The Nijatva signature, shared with every app in the suite -->
        <activity
            android:name="com.nijatva.signature.SignatureAppearanceActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity
            android:name="com.nijatva.signature.SignatureDeveloperActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".ZohoLoginActivity" android:exported="false" />
        <activity android:name=".OAuthRedirectActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mycontacts" android:host="oauth" />
            </intent-filter>
        </activity>
            <!-- Nijatva signature: who made this build, for anyone who inspects the APK -->
        <meta-data android:name="developer.name" android:value="Vasudev Dangaya" />
        <meta-data android:name="developer.origin" android:value="India" />
        <meta-data android:name="developer.site" android:value="https://vasudev-work.github.io" />
        <meta-data android:name="nijatva.suite" android:value="Nijatva" />
        <meta-data android:name="nijatva.signature" android:value="com.nijatva.signature" />

</application>
</manifest>